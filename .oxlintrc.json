{
  "plugins": ["typescript", "react"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/generatedSchema.ts",
    "**/_generated/**",
    "**/android/**",
    "**/ios/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  }
}
